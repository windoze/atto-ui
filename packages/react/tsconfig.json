{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": false,
    "types": ["node", "react"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "__test__/**/*.ts", "__test__/**/*.tsx"]
}
