{
  "name": "@atto-ui/core",
  "version": "0.1.0",
  "description": "Typed JavaScript facade for the atto-ui native runtime.",
  "type": "commonjs",
  "main": "index.js",
  "types": "index.ts",
  "files": [
    "index.js",
    "index.ts",
    "native.js",
    "native.d.ts",
    "src/builders.js",
    "src/builders.ts"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./index.ts",
      "require": "./index.js",
      "default": "./index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node __test__/headless.cjs && node __test__/builders.cjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  },
  "optionalDependencies": {
    "@atto-ui/node-darwin-arm64": "0.1.0",
    "@atto-ui/node-darwin-x64": "0.1.0",
    "@atto-ui/node-linux-x64-gnu": "0.1.0",
    "@atto-ui/node-win32-x64-msvc": "0.1.0"
  }
}
