def TextArea(*, title: str, text: str = ..., height: int = ..., enter_submits: bool = ..., placeholder: Optional[str] = ..., clipboard: Optional[str] = ..., kill_ring: Optional[str] = ..., history: Optional[Sequence[str]] = ..., enabled: Optional[bool] = ..., on_change: Optional[Callback] = ..., on_submit: Optional[Callback] = ..., cid: Optional[str] = ...) -> Component: ...
def Checkbox(*, label: str, checked: bool = ..., enabled: Optional[bool] = ..., on_change: Optional[Callback] = ..., cid: Optional[str] = ...) -> Component: ...
def RadioGroup(*, label: str, options: Sequence[str], selection: int = ..., height: Optional[int] = ..., enabled: Optional[bool] = ..., on_change: Optional[Callback] = ..., cid: Optional[str] = ...) -> Component: ...
