from __future__ import annotations

from pathlib import Path
from typing import Any, Callable, Dict, List, Optional, Sequence, Tuple, Union

from . import _native

AppHost = _native.AppHost

RectLike = Union[Tuple[int, int, int, int], List[int], Dict[str, int]]
PaddingLike = Union[int, List[int], Tuple[int, int, int, int], Dict[str, int]]
SizeLike = Union[str, int, Dict[str, int]]
Callback = Callable[["Event", Optional["ComponentRef"]], None]

class Event:
    callback_id: int
    event: str
    target_id: Optional[str]
    payload: Any
    def __init__(self, callback_id: int, event: str, target_id: Optional[str], payload: Any) -> None: ...

class ComponentRef:
    app: App
    window: Window
    cid: str
    def __init__(self, app: App, window: Window, cid: str) -> None: ...
    def set_prop(self, name: str, value: Any) -> None: ...
    def get_prop(self, name: str) -> Any: ...
    def bind_event(self, event: str, callback: Callback) -> int: ...
    def __getattr__(self, name: str) -> Any: ...

class Component:
    type_name: str
    cid: Optional[str]
    props: Dict[str, Any]
    children: List[Component]
    events: Dict[str, Union[int, Callback]]
    layout: Optional[Dict[str, Any]]
    meta: Optional[Dict[str, Any]]
    def __init__(
        self,
        type_name: str,
        *,
        cid: Optional[str] = ...,
        props: Optional[Dict[str, Any]] = ...,
        children: Optional[Sequence[Component]] = ...,
        events: Optional[Dict[str, Union[int, Callback]]] = ...,
        layout: Optional[Dict[str, Any]] = ...,
        meta: Optional[Dict[str, Any]] = ...,
    ) -> None: ...
    def with_layout(
        self,
        *,
        width: Optional[SizeLike] = ...,
        height: Optional[SizeLike] = ...,
        margin: Optional[PaddingLike] = ...,
        align_x: Optional[str] = ...,
        align_y: Optional[str] = ...,
        anchor: Optional[Dict[str, Any]] = ...,
        tab_index: Optional[int] = ...,
    ) -> Component: ...
    def with_meta(self, **meta: Any) -> Component: ...
    def to_dict(self) -> Dict[str, Any]: ...
    def to_child_dict(self) -> Dict[str, Any]: ...
    def to_spec(self, app: App) -> Dict[str, Any]: ...
    def to_child_spec(self, app: App) -> Dict[str, Any]: ...
    def collect_ids(self) -> List[str]: ...
    def collect_id_types(self) -> Dict[str, str]: ...
    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> Component: ...

class Window:
    app: App
    id: int
    title: str
    rect: RectLike
    content: Component
    elements: Dict[str, ComponentRef]
    def __init__(self, app: App, window_id: int, title: str, rect: RectLike, content: Component) -> None: ...
    def send_event(self, event: Dict[str, Any]) -> Dict[str, Any]: ...
    def click(self, column: int, row: int, *, button: str = ..., modifiers: Optional[Sequence[str]] = ...) -> Dict[str, Any]: ...
    def key(self, key: str, *, modifiers: Optional[Sequence[str]] = ...) -> Dict[str, Any]: ...
    def paste(self, text: str) -> Dict[str, Any]: ...
    def focus(self) -> bool: ...
    def close(self) -> bool: ...
    def move(self, x: int, y: int) -> bool: ...
    def resize(self, width: int, height: int) -> bool: ...
    def set_title(self, title: str) -> bool: ...
    def to_dict(self) -> Dict[str, Any]: ...
    @classmethod
    def from_dict(cls, app: App, data: Dict[str, Any]) -> Window: ...

class App:
    def __init__(self, *, headless: bool = ..., cols: int = ..., rows: int = ...) -> None: ...
    def register_callback(self, callback: Callback, callback_id: Optional[int] = ...) -> int: ...
    def add_dynamic_window(self, title: str, content: Union[Component, Dict[str, Any]], rect: RectLike = ...) -> Window: ...
    def step(self) -> bool: ...
    def run(self) -> None: ...
    def send_event(self, window: Union[Window, int], event: Union[str, Dict[str, Any]]) -> Dict[str, Any]: ...
    def click(self, window: Union[Window, int], column: int, row: int, *, button: str = ..., modifiers: Optional[Sequence[str]] = ...) -> Dict[str, Any]: ...
    def key(self, window: Union[Window, int], key: str, *, modifiers: Optional[Sequence[str]] = ...) -> Dict[str, Any]: ...
    def char(self, window: Union[Window, int], char: str, *, modifiers: Optional[Sequence[str]] = ...) -> Dict[str, Any]: ...
    def paste(self, window: Union[Window, int], text: str) -> Dict[str, Any]: ...
    def snapshot(self) -> Dict[str, Any]: ...
    def schemas(self) -> List[Dict[str, Any]]: ...
    def set_theme(self, name: str) -> None: ...
    def load_theme(self, path: Union[str, Path], *, base: str = ...) -> None: ...
    def list_windows(self) -> List[Dict[str, Any]]: ...
    def close_window(self, window: Union[Window, int]) -> bool: ...
    def focus_window(self, window: Union[Window, int]) -> bool: ...
    def move_window(self, window: Union[Window, int], x: int, y: int) -> bool: ...
    def resize_window(self, window: Union[Window, int], width: int, height: int) -> bool: ...
    def set_title(self, window: Union[Window, int], title: str) -> bool: ...
    def set_property(self, cid: str, name: str, value: Any) -> None: ...
    def get_property(self, cid: str, name: str) -> Any: ...

def register_all_runtime_components() -> None: ...
