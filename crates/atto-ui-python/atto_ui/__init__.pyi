def CommandPalette(*, items: Sequence[str], title: str = ..., query: str = ..., selection: int = ..., accepted: str = ..., open: bool = ..., open_on_empty: bool = ..., placeholder: Optional[str] = ..., height: int = ..., max_results: int = ..., enabled: Optional[bool] = ..., on_change: Optional[Callback] = ..., on_accept: Optional[Callback] = ..., on_close: Optional[Callback] = ..., cid: Optional[str] = ...) -> Component: ...
